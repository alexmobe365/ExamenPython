# --- PARTE B. LA SUPERCLASE ---
class Reserva:
    def __init__(self, cliente, destino, cantidad, precio_unitario):
        self.cliente = cliente
        self.destino = destino
        self.cantidad = cantidad
        self.precio_unitario = precio_unitario

    def precio_base(self):
        return self.cantidad * self.precio_unitario

    def precio_total(self):
        return self.precio_base()

    def unidad(self):
        return "unidades"

    def __str__(self):
        # El truco para extraer "VUELO", "HOTEL", etc., automáticamente del nombre de la clase
        tipo = type(self).__name__.replace("Reserva", "").upper()
        # :.1f o round() - usamos str() para imitar exactamente la salida del original
        precio_redondeado = str(round(self.precio_total(), 2))
        return f"{tipo} | {self.cliente} | {self.destino} | {self.cantidad} {self.unidad()} | {precio_redondeado} €"


# --- PARTE C. LAS SUBCLASES ---
class ReservaVuelo(Reserva):
    def unidad(self):
        return "pasajeros"

    def precio_total(self):
        # Base + 25 de tasas fijas
        precio = self.precio_base() + 25
        # Penalización si el billete es caro
        if self.precio_unitario > 200:
            precio += (self.cantidad * 30)
        return precio

class ReservaHotel(Reserva):
    def unidad(self):
        return "noches"

    def precio_total(self):
        precio = self.precio_base()
        # 10% de descuento si son 3 noches o más
        if self.cantidad >= 3:
            precio = precio * 0.90
        # Tasa turística de 1.5 por noche
        precio += (self.cantidad * 1.5)
        return precio

class ReservaTren(Reserva):
    def unidad(self):
        return "billetes"
    # No hace falta sobrescribir precio_total() porque coincide con el precio_base() del padre


# --- PARTE F. AMPLIACIÓN (Cruceros) ---
# Fíjate lo fácil que es añadir un nuevo tipo de reserva ahora
class ReservaCrucero(Reserva):
    def unidad(self):
        return "camarotes"

    def precio_total(self):
        return self.precio_base() * 1.12


# --- PARTE D. LA CLASE AGENCIA (Composición) ---
class Agencia:
    def __init__(self):
        self.reservas = []

    def agregar(self, reserva):
        self.reservas.append(reserva)

    def mostrar(self):
        for reserva in self.reservas:
            print(reserva)

    def total(self):
        # Usamos list comprehension + sum, como aprendimos en la Sección 7
        return sum([reserva.precio_total() for reserva in self.reservas])

    def contar_superiores_a(self, importe):
        # Filtramos con list comprehension y contamos su longitud
        return len([reserva for reserva in self.reservas if reserva.precio_total() > importe])


# --- PARTE E. EL PROGRAMA PRINCIPAL ---
agencia = Agencia()
agencia.agregar(ReservaVuelo("Ana López", "Madrid-Roma", 2, 120.0))
agencia.agregar(ReservaHotel("Luis Pérez", "Hotel Mar Azul", 3, 85.0))
agencia.agregar(ReservaTren("Marta Gil", "Madrid-Sevilla", 1, 45.0))
agencia.agregar(ReservaVuelo("Pablo Ruiz", "Madrid-Nueva York", 1, 300.0))
agencia.agregar(ReservaHotel("Eva Sanz", "Hotel Centro", 2, 140.0))

# Parte F (Añadir crucero)
agencia.agregar(ReservaCrucero("Jorge Vidal", "Crucero Mediterráneo", 1, 900.0))

agencia.mostrar()
print(f"TOTAL AGENCIA: {round(agencia.total(), 2)} €")
print(f"Reservas de más de 200 €: {agencia.contar_superiores_a(200)}")
