El Código
Python
class Articulo:
    # Constructor con valor por defecto para el stock
    def __init__(self, nombre, precio, stock=0):
        self.nombre = nombre
        self.precio = precio
        self.stock = stock

    def valor_inventario(self):
        return self.precio * self.stock

    def vender(self, cantidad):
        if self.stock >= cantidad:
            self.stock -= cantidad  # Es lo mismo que: self.stock = self.stock - cantidad
            return True
        else:
            return False

    def reponer(self, cantidad):
        self.stock += cantidad

    def __str__(self):
        return f"{self.nombre} | {self.precio} € | {self.stock} uds."

# --- Código de prueba del enunciado ---
